{
  "name": "intone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --port 4300 --strictPort",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch:models": "node build/models.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:effect": "effect-tsgo tsc -p tsconfig.json && effect-tsgo tsc -p tsconfig.node.json",
    "check:budget": "node build/bundle-budget.ts",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --ignore-pattern tests/lint/fixtures/ src tests build scripts && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings --ignore-pattern tests/lint/fixtures/ src tests build scripts",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "generate": "node build/generate.ts",
    "generate:check": "node build/generate.ts --check",
    "fixtures:synthetic": "node scripts/synthetic-voices.ts",
    "fixtures:voices": "node scripts/voice-fixtures.ts",
    "fixtures:voices-setup": "scripts/voicevox/setup.sh",
    "fixtures:formats": "node scripts/format-fixtures.ts",
    "fixtures:local-pack": "node scripts/local-pack-fixture.ts",
    "fixtures:tracked": "node --import ./scripts/source-imports.ts scripts/tracked-fixtures.ts",
    "score:study": "node --import ./scripts/source-imports.ts scripts/score-study.ts",
    "cut:study": "node --import ./scripts/source-imports.ts scripts/cut-study.ts",
    "sounds:features": "node --import ./scripts/source-imports.ts scripts/sound-features.ts",
    "sounds:study": "node --import ./scripts/source-imports.ts scripts/sounds-study.ts",
    "sounds:bench": "node --import ./scripts/source-imports.ts scripts/sounds-bench.ts",
    "vendor:foldkit": "scripts/vendor-foldkit.sh"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "@foldkit/ui": "0.170.0",
    "effect": "4.1.2",
    "fflate": "0.8.3",
    "foldkit": "0.170.0",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.2",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "21.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
