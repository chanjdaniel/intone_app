{
  "name": "intone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:effect": "effect-tsgo tsc -p tsconfig.json && effect-tsgo tsc -p tsconfig.node.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --ignore-pattern tests/lint/fixtures/ src tests && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings --ignore-pattern tests/lint/fixtures/ src tests",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "@foldkit/ui": "0.170.0",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.2",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
