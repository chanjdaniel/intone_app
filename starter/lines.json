{
  "version": 1,
  "levels": [
    {
      "id": "starter-heiban",
      "kind": "Heiban",
      "name": "Heiban: flat",
      "about": "Low on the first mora, then high to the end, the particle too: no fall."
    },
    {
      "id": "starter-atamadaka",
      "kind": "Atamadaka",
      "name": "Atamadaka: falls after the first",
      "about": "High on the first mora, then low from the second."
    },
    {
      "id": "starter-nakadaka",
      "kind": "Nakadaka",
      "name": "Nakadaka: falls inside the word",
      "about": "Rises after the first mora and falls before the word ends."
    },
    {
      "id": "starter-odaka",
      "kind": "Odaka",
      "name": "Odaka: falls onto the particle",
      "about": "Sounds flat on its own: the fall comes after the last mora, so the particle is low."
    },
    {
      "id": "starter-pairs",
      "kind": "Pairs",
      "name": "Pairs: the same kana, another accent",
      "about": "Words written alike in kana, told apart by where they fall."
    },
    {
      "id": "starter-phrases",
      "kind": "Phrases",
      "name": "Phrases: two words together",
      "about": "A word and its particle, then a verb in its ます form."
    }
  ],
