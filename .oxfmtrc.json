{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "ignoreCase": false,
    "customGroups": [
      { "groupName": "scoped", "elementNamePattern": ["@*", "@*/**"] }
    ],
    "groups": [
      ["builtin", "external"],
      "scoped",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "repos",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "NOTICES.md",
    "src/virtual-modules.d.ts",
    "fixtures/synthetic",
    "fixtures/voices",
    "fixtures/real",
    "fixtures/noise",
    "fixtures/formats",
    "fixtures/tracked",
    "docs/score-study.md",
    "docs/cut-study.md",
    "docs/sounds-study.md",
    "docs/transcription-study.md",
    "src/app/dev/cutStudyLines.json",
    "starter/lines.json",
    "starter/pack",
    "CREDITS.md"
  ]
}
